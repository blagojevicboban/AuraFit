{
  "entities": {
    "User": {
      "title": "User",
      "description": "Korisnički profil sa biometrijskim podacima i ciljevima",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["client", "coach", "admin"] },
        "gender": { "type": "string" },
        "age": { "type": "number" },
        "height": { "type": "number" },
        "weight": { "type": "number" },
        "goal": { "type": "string" },
        "activityLevel": { "type": "string" },
        "fitnessLevel": { "type": "string" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "DailyActivity": {
      "title": "DailyActivity",
      "description": "Dnevna statistika (koraci, kalorije)",
      "type": "object",
      "properties": {
        "steps": { "type": "number" },
        "caloriesBurned": { "type": "number" },
        "workoutDuration": { "type": "number" },
        "waterIntake": { "type": "number" }
      }
    },
    "Recipe": {
      "title": "Recipe",
      "description": "Recept za ishranu",
      "properties": {
        "title": { "type": "string" },
        "category": { "type": "string" },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "prepTime": { "type": "string" },
        "isRecipeOfDay": { "type": "boolean" },
        "imageUrl": { "type": "string" }
      }
    },
    "MealPlan": {
      "title": "MealPlan",
      "description": "Plan ishrane",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "recipeIds": { "type": "array", "items": { "type": "string" } },
        "durationDays": { "type": "number" }
      }
    },
    "ForumCategory": {
      "title": "ForumCategory",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "postCount": { "type": "number" }
      }
    },
    "Challenge": {
      "title": "Challenge",
      "properties": {
        "title": { "type": "string" },
        "intensity": { "type": "string" },
        "duration": { "type": "string" },
        "participantsCount": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": { "schema": { "$ref": "#/entities/User" } },
    "/users/{userId}/activity/{date}": { "schema": { "$ref": "#/entities/DailyActivity" } },
    "/recipes/{recipeId}": { "schema": { "$ref": "#/entities/Recipe" } },
    "/mealPlans/{planId}": { "schema": { "$ref": "#/entities/MealPlan" } },
    "/forumCategories/{catId}": { "schema": { "$ref": "#/entities/ForumCategory" } },
    "/challenges/{challengeId}": { "schema": { "$ref": "#/entities/Challenge" } }
  }
}
